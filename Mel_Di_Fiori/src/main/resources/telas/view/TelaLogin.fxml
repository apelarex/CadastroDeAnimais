<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="crud_colmeia.LoginController"
            style="-fx-background-color: linear-gradient(to bottom, #8d6035, #6b4c2a);"
            AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

    <!-- Container principal centralizado -->
    <VBox spacing="20" alignment="CENTER" 
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- Logo -->
        <ImageView fitWidth="300" fitHeight="300" preserveRatio="true">
            <image>
                <Image url="@/imagens/Logo06.png"/>
            </image>
        </ImageView>

        <!-- Título -->
        <Label text="Sistema de Adestramento" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0, 0, 2);"/>

        <!-- Formulário sem o retângulo transparente -->
        <VBox spacing="15" alignment="CENTER">
            
            <!-- Campo Usuário -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Usuário:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TextField fx:id="txtUsuario" promptText="Digite seu usuário" 
                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-pref-height: 35; -fx-font-size: 14px; -fx-pref-width: 200; -fx-max-width: 200; -fx-background-color: white;"/>
            </VBox>

            <!-- Campo Senha -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Senha:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <PasswordField fx:id="txtSenha" promptText="Digite sua senha" 
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-pref-height: 35; -fx-font-size: 14px; -fx-pref-width: 200; -fx-max-width: 200; -fx-background-color: white;"/>
            </VBox>

            <!-- Link "Esqueci minha senha" -->
            <Button text="Esqueci minha senha" 
                   style="-fx-background-color: transparent; -fx-text-fill: #e0e0e0; -fx-font-size: 12px; -fx-underline: true; -fx-padding: 5;"
                   onMouseEntered="#onHoverEsqueciSenha"
                   onMouseExited="#onHoverEsqueciSenhaSair"/>

            <!-- Mensagem de erro -->
            <Label fx:id="lblMensagem" style="-fx-text-fill: #ff6b6b; -fx-font-weight: bold; -fx-font-size: 12px; -fx-alignment: center;" 
                   visible="false" wrapText="true" maxWidth="250"/>

            <!-- Botões -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Entrar" onAction="#fazerLogin" 
                       style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-width: 100; -fx-pref-height: 35; -fx-background-radius: 8;"/>
                <Button text="Sair" onAction="#sair" 
                       style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-pref-width: 100; -fx-pref-height: 35; -fx-background-radius: 8;"/>
            </HBox>

        </VBox>

        <!-- Ajuda de navegação -->
        <Label text="Dica: Use TAB para navegar entre os campos e ENTER para fazer login" 
               style="-fx-text-fill: #e0e0e0; -fx-font-size: 11px; -fx-wrap-text: true; -fx-alignment: center; -fx-padding: 10;"/>

    </VBox>

</AnchorPane>